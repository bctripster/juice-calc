{
  "name": "juice-calc",
  "version": "1.0.10",
  "description": "E-liquid mixing calculator and recipe library",
  "main": "app/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --linux AppImage",
    "dist:win": "electron-builder --win"
  },
  "author": "bctripster",
  "license": "MIT",
  "devDependencies": {
    "electron": "^40.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "org.juicecalc.app",
    "productName": "Juice Calc",
    "files": [
      "app/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "app/icon.png",
      "category": "Utility",
      "artifactName": "JuiceCalc-${version}-x86_64.AppImage"
    },
    "publish": null,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "app/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "JuiceCalc-Setup-${version}.exe",
      "shortcutName": "Juice Calc"
    },
    "portable": {
      "artifactName": "JuiceCalc-${version}-portable.exe"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bctripster/juice-calc.git"
  }
}
